# Copy this file to .env (same folder) and fill in your values. .env is git-ignored.
# Variables already set in your shell override the values below.

# --- LLM: any OpenAI-compatible chat endpoint --------------------------------
OPENAI_API_KEY=your_api_key_here
# e.g. https://neuroii.com/v1
OPENAI_BASE_URL=your_base_url_here
# e.g. Qwen/Qwen3.8-27B-FP8
OPENAI_MODEL_NAME=your_model_name_here
# Output budget per call (reasoning + JSON answer). Leave empty for the server default.
# Keep prompt (~5k tokens) + LLM_MAX_TOKENS under the model's context window.
LLM_MAX_TOKENS=24576
# Client timeout in seconds; reasoning models can take minutes per call.
LLM_TIMEOUT=600
# Stream the response so proxies (e.g. Cloudflare, 100 s) do not time out long calls.
LLM_STREAM=true
# DeepSeek thinking mode (enabled/disabled); leave empty for servers without it.
LLM_THINKING=

# --- Qlib data paths ----------------------------------------------------------
QLIB_PATH_CN=/path/to/.qlib/qlib_data/cn_data
QLIB_PATH_SP500=/path/to/data/qlib_data/us_data_qlib

# --- Embedding model for semantic similarity in the retriever -----------------
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B
# Hugging Face mirror used for the ~8.1 GB embedding checkpoint.
HF_ENDPOINT=https://hf-mirror.com

# --- Langfuse tracing (optional; Settings -> API Keys in your project) --------
# auto: on when both keys are set; on: warn when keys are missing; off: disabled
LANGFUSE_TRACING=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com  US cloud: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separate test runs from real ones in the Langfuse UI
LANGFUSE_TRACING_ENVIRONMENT=development
